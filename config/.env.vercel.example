# Vercel build profile reference.
#
# The values below are set automatically by scripts/vercel/build.sh. This file
# documents the environment matrix for Vercel project settings and local
# debugging.

VITE_HOST_PROTOCOL=vercel

# Optional. Set this to a custom domain with wildcard DNS to enable the
# multi-origin sandbox. Leave it unset to use single-origin mode.
# VITE_VERCEL_WILDCARD_DOMAIN=example.com

# Multi-origin mode (VITE_VERCEL_WILDCARD_DOMAIN is set)
# VITE_EMBEDDER_ORIGIN_URL=https://web-ide.example.com
# VITE_WORKBENCH_BASE_URL=https://workbench.example.com/web-ide/public
# VITE_EXTENSIONS_HOST_BASE_URL=https://{{uuid}}.example.com/web-ide/public/vscode
# VITE_CROSS_ORIGIN_EXTENSION_HOST=true

# Single-origin mode (default for previews and *.vercel.app deployments)
# VITE_WORKBENCH_BASE_URL=web-ide/public
# VITE_EXTENSIONS_HOST_BASE_URL=web-ide/public/vscode
# VITE_CROSS_ORIGIN_EXTENSION_HOST=false
