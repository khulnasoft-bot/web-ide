{
  "name": "khulnasoft-vscode-theme",
  "displayName": "Khulnasoft Theme for Visual Studio Code",
  "description": "The Khulnasoft Theme for Visual Studio Code brings the sleek and professional look of Khulnasoft to your coding environment.",
  "version": "0.0.1",
  "publisher": "Khulnasoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khulnasoft/khulnasoft-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/khulnasoft/khulnasoft-vscode-theme/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "khulnasoft",
    "light",
    "dark"
  ],
  "scripts": {
    "package": "pnpm dlx @vscode/vsce@^3.1.1 package --no-dependencies",
    "build:font": "pnpm dlx webfont@11.2.26 ./fonts/icons/*.svg"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#171321",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Khulnasoft Dark Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/Khulnasoft_Dark_Midnight-color-theme.json"
      },
      {
        "label": "Khulnasoft Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Khulnasoft_Dark-color-theme.json"
      },
      {
        "label": "Khulnasoft Light",
        "uiTheme": "vs",
        "path": "./themes/Khulnasoft_Light-color-theme.json"
      }
    ],
    "icons": {
      "gitlab-tanuki": {
        "description": "GitLab Mono Tanuki",
        "default": {
          "fontPath": "fonts/gitlab_webide.woff",
          "fontCharacter": "\\eA01"
        }
      }
    }
  }
}
