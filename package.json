{
  "name": "web-ide-repo",
  "packageManager": "pnpm@10.34.7",
  "private": true,
  "homepage": "https://gitlab.com/gitlab-org/gitlab-web-ide",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/gitlab-org/gitlab-web-ide"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/format": "^19.8.1",
    "@commitlint/lint": "^19.8.1",
    "@commitlint/read": "^19.8.1",
    "@dotenvx/dotenvx": "^1.64.0",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "concurrently": "^7.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.5.1",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.14",
    "prettier": "3.6.2",
    "turbo": "^2.11.10",
    "typescript": "5.8.3"
  },
  "scripts": {
    "clean": "pnpm run clean:ts && pnpm run clean:dist",
    "clean:ts": "tsc -b --clean && rm -rf packages/*/lib",
    "clean:dist": "rm -rf packages/*/dist",
    "build:ts": "tsc -b",
    "build:webide": "make packages/web-ide",
    "build:example": "make packages/example",
    "build:example:http": "VITE_HOST_PROTOCOL=http make packages/example",
    "build:example:vercel": "bash ./scripts/vercel/build.sh",
    "build:vscode": "make packages/vscode-build/dist/vscode",
    "build:font": "pnpm --filter gitlab-vscode-theme build:font",
    "turbo:build": "turbo run build",
    "turbo:clean": "turbo run clean",
    "turbo:package": "turbo run package",
    "serve:example:https": "http-server ./packages/example/dist -a $IDE_HOST_MAIN_DOMAIN -p 8000 -c-1 --cors --ssl --cert $IDE_CERT_FILE --key $IDE_KEY_FILE",
    "serve:example:http": "http-server ./packages/example/dist -p 8000 -c-1 --cors",
    "watch:example": "pnpm build:example && nodemon --config nodemon.json --exec 'pnpm build:example'",
    "start:example": "dotenvx run -f config/.env.local -f config/.env -- ./scripts/start-example-app.sh",
    "start:example:http": "dotenvx run --env VITE_HOST_PROTOCOL=http -f config/.env.local -f config/.env -- ./scripts/start-example-app.sh",
    "cloudflare:deploy": "pnpm --filter cloudflare deploy",
    "cloudflare:start": "pnpm --filter cloudflare start",
    "deploy:vercel": "bash ./scripts/vercel/deploy.sh",
    "test": "jest",
    "test:ci": "jest --config ./jest.config.js --ci --reporters=default --reporters=jest-junit --watchAll=false",
    "test:integration": "pnpm exec playwright test -c ./tests/integration/playwright.config.ts --tsconfig ./tests/integration/tsconfig.json",
    "lint": "pnpm lint:prettier && pnpm lint:eslint",
    "lint:eslint": "eslint --max-warnings=0 --ext .js --ext .ts . ",
    "lint:prettier": "prettier --check .",
    "lint:prettier:write": "prettier --write .",
    "local-setup": "pnpm --filter @gitlab/vscode-build local-setup",
    "local-teardown": "pnpm --filter @gitlab/vscode-build local-teardown",
    "local-setup-gitlab-vscode-extension": "pnpm --filter @gitlab/gitlab-vscode-extension local-setup",
    "local-teardown-gitlab-vscode-extension": "pnpm --filter @gitlab/gitlab-vscode-extension local-teardown",
    "playwright:install": "pnpm exec playwright install --with-deps"
  },
  "dependencies": {
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.4.11"
  }
}
